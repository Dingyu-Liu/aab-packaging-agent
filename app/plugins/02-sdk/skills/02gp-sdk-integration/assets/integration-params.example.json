{
  "project_path": "/path/to/UnityProject",
  "unity_executable": "/path/to/Unity.app/Contents/MacOS/Unity",
  "android": {
    "formal_application_id": "com.example.studio.game",
    "test_application_id": "com.example.studio.game.test",
    "version_name": "1.0.0",
    "version_code": 1,
    "min_sdk": 25,
    "target_sdk": 36,
    "abi": "arm64-v8a",
    "orientation": "portrait",
    "hardware_accelerated": true
  },
  "pa": {
    "maven_group": "com.pakit.02",
    "artifact": "squad",
    "version": "1.0.0",
    "repository_url": "https://packages.aliyun.com/606ca7f5fde602776f084c4d/maven/2092324-release-xt1lx3",
    "credentials_source": "env-or-local-properties",
    "username_env": "PAKIT_MAVEN_USERNAME",
    "password_env": "PAKIT_MAVEN_PASSWORD",
    "mode": 0,
    "default_att": 2
  },
  "apps_flyer": {
    "dev_key": "<ask-user-or-read-from-project>",
    "apple_app_id": "<ask-user-or-read-from-project>",
    "enable_debug_only_in_development": true
  },
  "gaid": {
    "maven_coordinate": "com.google.android.gms:play-services-ads-identifier:18.0.0"
  },
  "signing": {
    "test_mode": "debug",
    "formal_keystore_path": "",
    "formal_key_alias": ""
  },
  "build": {
    "test_apk_method": "Partner02Build.BuildAndroidTestApk",
    "aab_method": "Partner02Build.BuildAndroidAab",
    "android_studio_export_method": "Partner02Build.ExportAndroidStudioProject",
    "output_dir": "/path/to/outputs",
    "install_after_build": false,
    "device_serial": ""
  },
  "delivery": {
    "default_artifact": "test_apk",
    "include_android_studio_project": false,
    "include_aab": false
  }
}
